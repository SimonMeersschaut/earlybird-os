[Unit]
Description=Earlybird alarm clock web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/earlybird/earlybird-os
ExecStart=/usr/bin/python3 /home/earlybird/earlybird-os/run.py --host 127.0.0.1 --port 8000
User=earlybird
Group=earlybird
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target